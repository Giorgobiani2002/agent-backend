DATABASE_URL=postgres://postgres:<password>@switchyard.proxy.rlwy.net:28224/railway
DATABASE_URL_PRIVATE=postgres://postgres:<password>@pgvector.railway.internal:5432/railway
PGDATABASE=railway
PGHOST=switchyard.proxy.rlwy.net
PGHOST_PRIVATE=pgvector.railway.internal
PGPASSWORD=<password>
PGPORT=28224
PGPORT_PRIVATE=5432
PGUSER=postgres
POSTGRES_DB=railway

# Set this if your PostgreSQL endpoint requires TLS.
# PGSSLMODE=require

CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=25mb

# Gemini API key (AI Studio). Auth + billing run through the Gemini API SKU so
# the $1,000 GenAI App Builder credit applies. This replaces the Vertex AI
# service-account auth below.
GEMINI_API_KEY=AIzaSy...
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_PLAYBOOK_MODEL=gemini-3.5-flash
GEMINI_STT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_STT_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_EMBEDDING_DIMENSIONS=1536
# ── Legacy Vertex AI auth (no longer used after the Gemini API migration) ──
# GCP_PROJECT_ID=gen-lang-client-0730194112
# GCP_LOCATION=global
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GCP_MEDIA_BUCKET=declario-vertex-media-gen-lang-client-0730194112
GEMINI_CHAT_MAX_OUTPUT_TOKENS=8192
GEMINI_CHAT_TEMPERATURE=0.55
RAG_MAX_CONTEXT_CHARS=140000
RAG_PROMPT_CHAR_HARD_CAP=155000
RAG_CHUNK_ANCHOR_WINDOW=40
