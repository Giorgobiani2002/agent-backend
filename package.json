{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "books:ingest-data": "ts-node src/scripts/ingest-data.ts",
    "knowledge:ingest-md": "ts-node src/scripts/ingest-markdown.ts",
    "transcripts:ingest": "ts-node src/scripts/ingest-transcripts.ts",
    "db:ingest": "npm run books:ingest-data --",
    "db:migrate": "node scripts/migrate.js",
    "db:setup": "npm run db:migrate && npm run db:ingest",
    "start": "node dist/index.js",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^1.51.0",
    "@sentry/node": "^10.55.0",
    "@types/multer": "^2.1.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
